        <div class="social">
          <a href="https://wa.me/" class="social__whatsapp" target="_blank" rel="noreferrer" aria-label="WhatsApp"></a>
          <a href="https://t.me/" class="social__telegram" target="_blank" rel="noreferrer" aria-label="Telegram"></a>
          <a href="https://vk.com/" class="social__vk" target="_blank" rel="noreferrer" aria-label="VKontakte"></a>
        </div>

        <a class="phone" href="tel:+74957773341">+7 495 777 33 41</a>
      </div>

      <nav class="footer__nav" aria-label="Навигация в подвале">
        <ul>
          <li><a href="/#search-tour" class="nav__link">Поиск тура</a></li>
          <li><a href="/#about" class="nav__link">О нас</a></li>
          <li><a href="/#cruises" class="nav__link">Круизы</a></li>
          <li><a href="/#feedback" class="nav__link">Отзывы</a></li>
          <li><a href="/#stock" class="nav__link">Акции</a></li>
          <li><a href="/#services" class="nav__link">Услуги</a></li>
        </ul>
      </nav>

      <div class="footer__address">
        <div>
          <p>пн-птн с 9:00 до 19:00</p>
          <p>Адрес: г. Москва, ул. Ленина 19, офис 301</p>
        </div>
        <button class="footer__feedback-btn feedback-btn" type="button">
          Обратный звонок
