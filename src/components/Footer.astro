    <div class="footer__privacy">
      <a href="/privacy" target="_blank" rel="noreferrer">Положение об обработке персональных данных</a><br />
      <a href="/consent" target="_blank" rel="noreferrer">Согласие на обработку персональных данных</a><br />
      <button type="button" data-open-cookie-settings>Настройки cookie</button><br />
      Информация на сайте не является публичной офертой и носит исключительно информационный характер.<br />
      ИНН 4722222222222 ОГРН 3777777777777
    </div>
  </div>

  <a
    class="nice-dev"
    href="https://nice-dev.ru/"
    target="_blank"
    rel="noreferrer"
  >
    © Nice Dev Web-Studio 2020 - {currentYear}
  </a>
</footer>

<style>
  .footer {
    padding: 50px 0 20px;
    background-color: var(--link-active);
    margin-top: 100px;
  }

  .footer__info {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 50px;
  }

  .footer .social {
    margin: 25px 0;
  }

  @media (max-width: 580px) {
    .footer__info,
    .footer .social {
      justify-content: center;
    }
  }

  .footer .phone {
    font-size: 24px;
    color: #fff;
  }

  .footer__nav ul {
    display: grid;
    grid-template-columns: max-content max-content;
    gap: 40px 100px;
    padding: 0;
    margin: 0;
  }

  .footer__nav .nav__link {
    font-size: 18px;
    font-weight: 500;
    color: #fff;
    border-bottom: 1px solid transparent;
    transition: 0.3s;
    text-decoration: none;
  }

  .footer__nav .nav__link:hover {
    border-bottom: 1px solid #fff;
  }

  .footer__address p {
    color: #fff;
    text-align: right;
    font-size: 18px;
    font-weight: 500;
    margin: 0;
  }

  .footer__address p:not(:last-of-type) {
    margin-bottom: 15px;
  }

  @media (max-width: 980px) {
    .footer__address {
      display: flex;
      flex-direction: row-reverse;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap-reverse;
      row-gap: 20px;
      width: 100%;
    }

    .footer__address p {
      max-width: 290px;
    }
  }

  @media (max-width: 580px) {
    .footer__address {
      justify-content: center;
    }

    .footer__address p {
      text-align: center;
    }
  }

  .footer__feedback-btn {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-radius: 30px;
    background-color: #fff;
    font-size: 18px;
    font-weight: 700;
    max-width: 240px;
    width: 100%;
    padding: 15px 20px;
    margin: 50px 0 0 auto;
    border: none;
    cursor: pointer;
    transition: 0.3s;
  }

  @media (max-width: 980px) {
    .footer__feedback-btn {
      margin: 0;
    }
  }

  .footer__feedback-btn svg path {
    fill: #0c2626;
    transition: 0.3s;
  }

  .footer__feedback-btn:hover {
    background-color: var(--link-hover);
    color: #fff;
  }

  .footer__feedback-btn:active {
    background-color: transparent;
    color: #fff;
    outline: 1px solid #fff;
  }

  .footer__feedback-btn:hover svg path {
    fill: #fff;
  }

  .footer__feedback-btn:active svg path {
    fill: #fff;
  }

  .footer__privacy {
    margin-top: 60px;
    color: #fff;
    font-family: 'Roboto', serif;
    font-size: 12px;
    line-height: 1.6;
  }

  .footer__privacy a,
  .footer__privacy button {
    color: #fff;
    border-bottom: 1px solid #fff;
    background: none;
    border-top: none;
    border-left: none;
    border-right: none;
    padding: 0;
    font: inherit;
    cursor: pointer;
  }

  @media (max-width: 768px) {
    .footer__privacy {
      max-width: 360px;
    }
  }

  .nice-dev {
    display: flex;
    justify-content: center;
    width: fit-content;
    margin: 40px auto 0;
    font-size: 12px;
    color: #fff;
    text-decoration: none;
    animation: colorTransform 5s infinite;
  }

  @keyframes colorTransform {
    0% {
      color: #fff;
    }
    50% {
      color: #fbb42c;
    }
    100% {
      color: #fff;
    }
  }
</style>
