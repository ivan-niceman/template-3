---
// Services component with travel services cards
import service1 from '../assets/images/services/serviсes-1.jpeg';
import service2 from '../assets/images/services/serviсes-2.jpeg';
import service3 from '../assets/images/services/serviсes-3.jpeg';
import service4 from '../assets/images/services/serviсes-4.jpeg';
import service5 from '../assets/images/services/serviсes-5.jpeg';
import service6 from '../assets/images/services/serviсes-6.jpeg';

const services = [
  {
    image: service1.src,
    alt: 'Туры по выгодным ценам',
    title: 'Туры по выгодным ценам',
  },
  {
    image: service2.src,
    alt: 'Авиабилеты в любую точку мира',
    title: 'Авиабилеты в любую точку мира',
  },
  {
    image: service3.src,
    alt: 'Ж/д билеты по России',
    title: 'Ж/д билеты по России',
  },
  {
    image: service4.src,
    alt: 'Проживание в отелях по всему миру',
    title: 'Проживание в отелях по всему миру',
  },
  {
    image: service5.src,
    alt: 'Трансферы любого класса обслуживания',
    title: 'Трансферы любого класса обслуживания',
  },
  {
    image: service6.src,
    alt: 'Открытие виз в разные страны',
    title: 'Открытие виз в разные страны',
  },
];
---

<section class="services" id="services">
  <div class="container">
    <h2 class="title">услуги</h2>
    <ul class="cards__list">
      {services.map((service) => (
        <li class="cards__item">
          <div class="cards__item-overflow">
            <img
              src={service.image}
              alt={service.alt}
              class="cards__img"
              loading="lazy"
              width="335"
              height="165"
            />
          </div>
          <p class="cards__description">{service.title}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .services {
    margin-top: 50px;
    background: rgb(176, 190, 197);
    padding-bottom: 50px;
  }

  @media (max-width: 600px) {
    .services {
      margin-top: 5px;
    }
  }

  .services .title {
    color: var(--link-hover);
  }

  .cards__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(270px, 335px));
    justify-content: center;
    gap: 20px;
    max-width: 1100px;
    margin: 50px auto 0;
    padding: 0;
  }

  .cards__item {
    border-radius: 20px;
    padding: 15px 15px 20px;
    background-color: #fff;
    box-shadow: 0px 20px 20px 0px rgba(0, 0, 0, 0.1);
    overflow: hidden;
  }

  .cards__item-overflow {
    border-radius: 15px;
    overflow: hidden;
  }

  .cards__img {
    display: block;
    width: 100%;
    max-height: 165px;
    object-fit: cover;
    border-radius: 15px;
    transition: 0.7s;
  }

  .cards__img:hover {
    transform: scale(1.2);
  }

  .cards__description {
    font-size: 18px;
    font-weight: 700;
    text-align: center;
    max-width: 250px;
    margin: 10px auto 0;
  }
</style>
