---
// Partners marquee ticker
import anexTour from '../assets/images/partners/anex-tour.png';
import intourist from '../assets/images/partners/Intourist.png';
import coral from '../assets/images/partners/coral.png';
import sunmar from '../assets/images/partners/Sunmar.png';
import pegas from '../assets/images/partners/pegas.png';
import alean from '../assets/images/partners/alean.png';
import funsun from '../assets/images/partners/funsun.png';

const partners = [
  { src: anexTour.src, alt: 'анекс тур' },
  { src: intourist.src, alt: 'интурист' },
  { src: coral.src, alt: 'корал тревел' },
  { src: sunmar.src, alt: 'санмар' },
  { src: pegas.src, alt: 'пегас' },
  { src: alean.src, alt: 'алеан' },
  { src: funsun.src, alt: 'фансан' },
];
---

<section class="partners container">
  <div class="marque" data-direction="left" data-animated="true">
    <ul class="marque-list">
      {partners.map((p) => (
        <li>
          <img src={p.src} alt={p.alt} loading="lazy" width="145" height="75" />
        </li>
      ))}
      <!-- Duplicated for infinite smooth loop -->
      {partners.map((p) => (
        <li aria-hidden="true">
          <img src={p.src} alt={p.alt} loading="lazy" width="145" height="75" />
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .marque {
    margin-top: 100px;
    overflow: hidden;
  }

  .marque-list {
    display: flex;
    align-items: center;
    column-gap: 70px;
    padding: 0;
    margin: 0;
  }

  .marque-list img {
    width: 145px;
    height: 75px;
    object-fit: contain;
    filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.06));
  }

  .marque[data-animated="true"] {
    overflow: hidden;
    mask: linear-gradient(90deg, transparent, #000 5%, #000 95%, transparent);
  }

  .marque[data-animated="true"] .marque-list {
    width: max-content;
    flex-wrap: nowrap;
    animation: marque 30s linear infinite;
  }

  @keyframes marque {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
</style>
