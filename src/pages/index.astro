---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import TourSearch from '../components/TourSearch.astro';
import CruiseSearch from '../components/CruiseSearch.astro';
import FindTours from '../components/FindTours.astro';
import Services from '../components/Services.astro';
import About from '../components/About.astro';
import Team from '../components/Team.astro';
import Feedback from '../components/Feedback.astro';
import Partners from '../components/Partners.astro';
import Map from '../components/Map.astro';
import Footer from '../components/Footer.astro';
import ModalForm from '../components/ModalForm.astro';
import CookieBanner from '../components/CookieBanner.astro';
import SocialFloating from '../components/SocialFloating.astro';
import UpwardButton from '../components/UpwardButton.astro';
---

<Layout
  title="Горящие туры и круизы в Москве — Турагентство | Поиск выгодных туров со скидками"
  description="Поиск горящих туров из Москвы со скидками. Сервис подбора туров по России и всему миру, поиска круизов и бронирования путешествий."
>
  <Header />
  <main class="main">
    <Hero />
    <TourSearch />
    <CruiseSearch />
    <FindTours />
    <Services />
    <About />
    <Team />
    <Feedback />
    <Partners />
    <Map />
  </main>
  <Footer />
  <ModalForm />
  <CookieBanner />
  <SocialFloating />
  <UpwardButton />
</Layout>
